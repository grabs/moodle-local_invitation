{{!
    @template local_invitation/possible_info

    A template to show the invitation info including the invite url and a qu-code

    Example context (json):
    {
        "exceeded": true,
        "possibleinfo": "Possible invitations: 5/5"
    }
}}
{{^exceeded}}
    <h5 class="text-success"><i class="fa fa-info-circle fa-fw"></i>{{possibleinfo}}</h5>
{{/exceeded}}
{{#exceeded}}
    <h5 class="text-danger"><i class="fa fa-warning fa-fw"></i>{{possibleinfo}}</h5>
{{/exceeded}}
<hr>
