{{!
    @template local_invitation/invitation_list

    A template to show the invitation info including the invite url and a qu-code

    Example context (json):
    {
        "possibleinfo": "Possible invitations",
        "hasinvitations": true,
        "invitations": [
            "<h5>Invitation-1</h5>",
            "<h5>Invitation-2</h5>",
            "<h5>Invitation-3</h5>"
        ]
    }
}}
<h4>{{possibleinfo}}</h4>
{{#hasinvitations}}
    <div class="d-flex flex-column mt-2">
        {{#invitations}}
            {{{.}}}
        {{/invitations}}
    </div>
{{/hasinvitations}}
